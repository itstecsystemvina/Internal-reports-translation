# Postgres connection string. On Vercel this is set automatically when you add Neon from the Storage tab.
# Leave empty locally to use a built-in file database (.pglite folder).
DATABASE_URL=

# Long random string used to sign login sessions. Generate one with: openssl rand -base64 32
SESSION_SECRET=

# Google Gemini API key for Vietnamese -> Korean translation (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Starting password for the first admin and for new employees (at least 6 characters).
# Never commit the real value: the repository is public.
DEFAULT_PASSWORD=

# Secret for the daily translation job (/api/cron/translate). Vercel sends it automatically once set.
# Generate one with: openssl rand -base64 32
CRON_SECRET=
